# Optional. The app automatically uses TheMealDB's public development key.
# Replace this only if you later purchase a supporter/production key.
THEMEALDB_API_KEY=1

# Optional locally; required for persistent cloud deployment.
# Vercel's Neon integration supplies this automatically.
DATABASE_URL=

# Supabase email/password authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used exclusively for self-service account deletion.
# Never prefix this variable with NEXT_PUBLIC_ or commit its real value.
SUPABASE_SECRET_KEY=
