# Optional. The app automatically uses TheMealDB's public development key.
# Replace this only if you later purchase a supporter/production key.
THEMEALDB_API_KEY=1

# Optional locally; required for persistent cloud deployment.
# Vercel's Neon integration supplies this automatically.
DATABASE_URL=

# Clerk authentication. Create these free keys at https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
